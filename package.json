{
  "name": "vimlore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VIMLORE — a Vim adventure game that teaches real Vim by feel",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node tools/inline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint:levels": "node --experimental-strip-types tools/level-lint.ts",
    "oracle": "node --experimental-strip-types tools/oracle-diff.ts",
    "fuzz": "node --experimental-strip-types tools/fuzz.ts",
    "doc-check": "node --experimental-strip-types tools/doc-check.ts",
    "doctor": "node --experimental-strip-types tools/doctor.ts",
    "invariants": "node --experimental-strip-types tools/invariants.ts",
    "verify": "npm test && npm run lint:levels && npx tsc --noEmit && npm run doc-check && npm run invariants && npm run build && npm run budget && npm run pwa:check && npm run presentation:check",
    "verify:full": "npm run verify && npm run oracle && node --experimental-strip-types tools/fuzz.ts --n=1000 --seed=7",
    "budget": "node --experimental-strip-types tools/bundle-budget.ts",
    "books:index": "node --experimental-strip-types tools/book-index.ts",
    "provenance": "node --experimental-strip-types tools/stage-provenance.ts",
    "kickoff": "node --experimental-strip-types tools/kickoff.ts",
    "surface": "node --experimental-strip-types tools/surface-audit.ts",
    "surface:write": "node --experimental-strip-types tools/surface-audit.ts --write",
    "matrix": "node --experimental-strip-types tools/matrix.ts",
    "matrix:write": "node --experimental-strip-types tools/matrix.ts --write",
    "state-matrix": "node --experimental-strip-types tools/state-matrix.ts",
    "state-matrix:write": "node --experimental-strip-types tools/state-matrix.ts --write",
    "trace": "node --experimental-strip-types tools/trace.ts",
    "count-matrix": "node --experimental-strip-types tools/count-matrix.ts",
    "status:write": "node --experimental-strip-types tools/status.ts",
    "status:check": "node --experimental-strip-types tools/status.ts --check",
    "browser:qa": "node tools/browser-qa.mjs",
    "browser:setup": "bash tools/browser-setup.sh",
    "browser:audit": "node tools/browser-audit.mjs",
    "books:build": "python3 tools/books/build_corpus.py",
    "books:search": "python3 tools/books/context.py search",
    "books:read": "python3 tools/books/context.py read",
    "books:toc": "python3 tools/books/context.py toc",
    "books:stats": "python3 tools/books/context.py stats",
    "books:merge": "python3 tools/books/merge_audit.py",
    "books:spellcheck": "python3 tools/books/spellcheck.py",
    "books:priority": "python3 tools/books/priority_structure.py",
    "books:priority:merge": "python3 tools/books/priority_merge.py",
    "books:priority:read": "python3 tools/books/priority.py",
    "books:priority:map": "node --experimental-strip-types tools/books/priority_map.ts",
    "level-oracle": "node --experimental-strip-types tools/level-oracle.ts",
    "books:stage-map": "python3 tools/books/merge_stage_map.py",
    "pwa:check": "node tools/pwa-check.mjs",
    "pwa:qa": "node tools/pwa-qa.mjs",
    "pwa:icons": "node tools/pwa-icons.mjs",
    "presentation:check": "node tools/presentation-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "author": "Jung Donghee",
  "license": "MIT"
}
