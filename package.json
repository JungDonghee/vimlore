{
  "name": "vimlore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VIMLORE — a Vim adventure game that teaches real Vim by feel",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node tools/inline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint:levels": "node --experimental-strip-types tools/level-lint.ts",
    "oracle": "node --experimental-strip-types tools/oracle-diff.ts",
    "fuzz": "node --experimental-strip-types tools/fuzz.ts",
    "doc-check": "node --experimental-strip-types tools/doc-check.ts",
    "doctor": "node --experimental-strip-types tools/doctor.ts",
    "invariants": "node --experimental-strip-types tools/invariants.ts",
    "verify": "npm test && npm run lint:levels && npx tsc --noEmit && npm run doc-check && npm run invariants && npm run build && npm run budget",
    "verify:full": "npm run verify && npm run oracle && node --experimental-strip-types tools/fuzz.ts --n=1000 --seed=7",
    "budget": "node --experimental-strip-types tools/bundle-budget.ts",
    "books:index": "node --experimental-strip-types tools/book-index.ts",
    "provenance": "node --experimental-strip-types tools/stage-provenance.ts",
    "kickoff": "node --experimental-strip-types tools/kickoff.ts",
    "surface": "node --experimental-strip-types tools/surface-audit.ts",
    "surface:write": "node --experimental-strip-types tools/surface-audit.ts --write",
    "matrix": "node --experimental-strip-types tools/matrix.ts",
    "matrix:write": "node --experimental-strip-types tools/matrix.ts --write",
    "state-matrix": "node --experimental-strip-types tools/state-matrix.ts",
    "state-matrix:write": "node --experimental-strip-types tools/state-matrix.ts --write"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "author": "Jung Donghee",
  "license": "MIT"
}
